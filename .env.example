# Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered on that app (Apps & Credentials > your app > Webhooks)
PAYPAL_WEBHOOK_ID=
# Buyer-side API dispute creation is not used: it needs the DISPUTE_CREATE scope,
# which only a PayPal account manager can add. Disputes are opened manually in
# the sandbox as the personal buyer, so no buyer credentials are needed here.
# Seconds between dispute polls (GET /v1/customer/disputes). Optional, default 10.
POLL_SECONDS=10
# Decision agent (LiteLLM). Key from Google AI Studio.
GEMINI_API_KEY=
# Optional. Any LiteLLM model name; default gemini/gemini-2.5-flash.
LLM_MODEL=gemini/gemini-2.5-flash
# Optional. Local FalkorDB (docker run -p 6379:6379 falkordb/falkordb).
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
