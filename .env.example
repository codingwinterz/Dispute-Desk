# Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered on that app (Apps & Credentials > your app > Webhooks)
PAYPAL_WEBHOOK_ID=
# Buyer-side API dispute creation is not used: it needs the DISPUTE_CREATE scope,
# which only a PayPal account manager can add. Disputes are opened manually in
# the sandbox as the personal buyer, so no buyer credentials are needed here.
